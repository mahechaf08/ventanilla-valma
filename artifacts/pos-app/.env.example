# Socket.IO server URL for multi-device sync (required for cross-PC sales).
# Dev default in code: http://localhost:8080
# Production: set to your Render API origin, e.g. https://your-api.onrender.com
VITE_SOCKET_URL=

# Optional HTTP API origin for Neon sales sync (defaults to VITE_SOCKET_URL).
# VITE_API_URL=https://your-api.onrender.com
#
# After deploy, run on the API host (with DATABASE_URL):
#   pnpm --filter @workspace/db push
# to create the pos_sales table used for cross-device Historial/Registro.
